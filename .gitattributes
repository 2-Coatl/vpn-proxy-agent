# ============================================
# Git Attributes - Line Ending Configuration
# ============================================
# Set default behavior: auto-normalize line endings
* text=auto

# ============================================
# Shell Scripts - MUST use LF (Unix)
# ============================================
# Critical: These files MUST have LF for Linux/Vagrant execution
*.sh text eol=lf
*.bash text eol=lf

# ============================================
# Python - LF (Unix standard)
# ============================================
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# ============================================
# Vagrant and Configuration
# ============================================
Vagrantfile text eol=lf
*.conf text eol=lf
*.config text eol=lf

# ============================================
# Systemd and Service Files - LF
# ============================================
*.service text eol=lf
*.socket text eol=lf
*.timer text eol=lf
*.target text eol=lf

# ============================================
# Windows Scripts - CRLF
# ============================================
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

