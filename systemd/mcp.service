[Unit]
Description=MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/var/lib/mcp
EnvironmentFile=/etc/mcp/mcp.env
ExecStart=/usr/local/bin/run_mcp.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=append:/var/log/mcp/mcp-server.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
